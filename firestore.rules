rules_version = '2';

// Sync store for Budget Manager: one document per signed-in user, at
// budgets/{uid}. The whole budget is a single document (all months, goals
// and settings), kept far below Firestore's 1 MiB limit by the client.
//
// Access control is deliberately minimal and total: a signed-in user sees
// and writes only their own document; everything else on the database is
// closed. There are no shared reads, no roles, and nothing is public.
service cloud.firestore {
  match /databases/{database}/documents {
    match /budgets/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // Anything not named above stays closed, whatever a future collection
    // is called.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
